#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Yapaia Beat – start the radio service
# ==============================================================================
bashio::log.info "Starte Yapaia Beat ..."

if ! ls /dev/bus/usb >/dev/null 2>&1; then
    bashio::log.warning "Kein USB-Bus sichtbar – ist der RTL-SDR Stick eingesteckt?"
fi

cd /opt/yapaia || bashio::exit.nok "Anwendung fehlt"
exec python3 -m yapaia
